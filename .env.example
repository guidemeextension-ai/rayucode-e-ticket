# Copy to .env and fill in. .env is gitignored — never commit real values.

# ─── Web app ───
# Both are required in production. There is no built-in fallback: this repo
# is public, so a hardcoded default would be a published password.
# Generate real values with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_PASSWORD=your-admin-password

# Preferred port. If it is busy the app moves to the next free one — unless
# it is running on Railway, where the platform fixes the port.
# PORT=5050

# Where the JSON record store lives. On Railway point this at a mounted volume
# (/data/promo_records.json) or every deploy wipes the records and chat ids.
# DATA_FILE=promo_records.json

# ─── Telegram bot ───
# From @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional — resolved automatically via getMe if omitted
# TELEGRAM_BOT_USERNAME=jumnuybot

# Random string Telegram echoes back in the X-Telegram-Bot-Api-Secret-Token
# header. Required for webhook mode.
# TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string

# Public https base URL of this deployment. Optional — derived per request
# from the proxy headers when set on Railway.
# PUBLIC_URL=https://your-app.up.railway.app

# Optional — restrict the bot to specific Telegram chat ids (comma separated).
# Empty means anyone who finds the bot can look up a ticket.
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321

# Optional — log instead of sending. Useful while testing.
# TELEGRAM_DRY_RUN=1
