# Copy to .env for local use. Never commit real values; .env is gitignored.
# Set production values in the Vercel/Railway dashboard, then redeploy.
# Placeholder values below are NOT usable production credentials.

# Web app: stable values required on Vercel and Railway.
# Generate each secret separately:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-long-random-session-key
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Durable storage: BOTH required on Vercel; optional on Railway/local.
# Use the HTTPS REST endpoint and read/write REST token, NOT a redis:// URL.
# Configuring Redis selects it instead of JSON; errors do not fall back to JSON.
# Set these in Production scope on Vercel. Use separate databases for previews.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-rest-token

# Local/Railway JSON mode only (when neither Upstash variable is configured).
# On Railway mount /data and set BOTH paths; Vercel cannot use local persistence.
# DATA_FILE=/data/promo_records.json
# CONTACTS_FILE=/data/telegram_contacts.json
# Defaults locally: promo_records.json and telegram_contacts.json.

# Local preferred port; if busy the app moves to the next free port.
# Railway supplies a fixed PORT. No PORT setting is needed on Vercel.
# PORT=5050

# Telegram token from @BotFather; required for delivery and webhooks.
TELEGRAM_BOT_TOKEN=replace-with-your-botfather-token
# Recommended: explicit bot username (no @) for start links without a lookup.
# TELEGRAM_BOT_USERNAME=your_bot_username

# Required for webhook activation. Generate a separate random secret.
# Telegram sends it in X-Telegram-Bot-Api-Secret-Token; never put it in a URL.
# TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Required production activation setting: stable public HTTPS origin only.
# No /telegram/webhook suffix, other path, query, or fragment.
# Assign the production domain, redeploy, then click Connect Webhook in admin.
# PUBLIC_URL=https://your-project.vercel.app
# Railway alternative: https://your-app.up.railway.app

# Optional: restrict ticket lookups to comma-separated Telegram chat IDs.
# Unset/blank permits anyone who finds the bot to look up tickets.
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321

# Ticket creation admin copies: defaults below apply when this variable is unset.
# Each recipient must first Start this bot in a PRIVATE chat with a username.
# Copies contain image + code/name/phone/discount/created_at, not revenue data.
# Best effort only, not a durable backup queue or disaster-recovery system.
# Creation shares a 50s deadline starting before persistence. Backups use the
# earlier of that deadline and their own 48s cap, reserving 24s per recipient
# (13s contact + 11s upload). Both admins can receive copies on a fast path;
# slow services may cause skips. These are not configurable environment knobs.
# Requests inactivity timeouts do not strictly cancel work at the deadline.
# TELEGRAM_BACKUP_USERNAMES=President_Alien,SassdahRAK
# To disable, explicitly set TELEGRAM_BACKUP_USERNAMES to an empty value:
# TELEGRAM_BACKUP_USERNAMES=

# Optional: log instead of delivering; UI reports no delivery.
# Logs may contain ticket/contact details. Use synthetic test data.
# TELEGRAM_DRY_RUN=1
